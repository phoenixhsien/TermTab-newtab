{
  "name": "Linux Like New Tab",
  "version": "1.0.0",
  "description": "一个linux风格的新标签页，通过终端指令管理链接、备忘录、背景等",
  "manifest_version": 3,
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "downloads"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["langs/*.json", "themes/*.jpg", "icons/*.png"],
      "matches": ["<all_urls>"]
    }
  ]
}